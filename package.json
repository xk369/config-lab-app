{
  "name": "config-lab-app",
  "version": "1.0.0",
  "description": "Simple modular web application for repository and containerization labs.",
  "main": "src/cli.js",
  "scripts": {
    "start": "node src/cli.js server",
    "dev": "APP_ENV=development node src/cli.js server",
    "migrate": "node src/cli.js migrate",
