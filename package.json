    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^4.1.1",
    "pg": "^8.20.0"
  },
  "engines": {
    "node": ">=22"
  }
}
