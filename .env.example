APP_NAME=Config Lab App
APP_ENV=development
HOST=0.0.0.0
PORT=3001
DATA_FILE=data/tasks.runtime.json
CONFIG_FILE=config/local.yaml
AUTO_MIGRATE=true
DB_CLIENT=sqlite
SQLITE_FILE=data/tasks.sqlite
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=config_lab_app
DATABASE_USER=config_lab_app
DATABASE_PASSWORD=replace-with-database-password
DATABASE_SSL=false
SESSION_STORE=memory
REDIS_URL=redis://localhost:6379
EXTERNAL_SERVICE_URL=https://api.example.local
API_TOKEN=replace-with-local-token
RELEASE_VERSION=local-dev
INSTANCE_ID=local-instance
SHUTDOWN_TIMEOUT_MS=10000
SHUTDOWN_DRAIN_MS=500
LOG_LEVEL=info
